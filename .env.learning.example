# Example only. Never commit real values.
# Set these only in an isolated MAXYRON development environment.
LEARNING_BACKEND_ENABLED=false
LEARNING_AUTH_ISSUER=
LEARNING_AUTH_AUDIENCE=
LEARNING_AUTH_JWKS_URL=
LEARNING_DATABASE_URL=
# Do not put credentials in NEXT_PUBLIC_* variables.

# Neon Auth Next.js SDK: development environment only.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Runtime-role connection string only, never database owner.
# LEARNING_DATABASE_URL must include sslmode=verify-full.
# No learner endpoints are active until LEARNING_BACKEND_ENABLED=true.
